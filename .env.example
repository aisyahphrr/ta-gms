# ==============================================================================
# GMS (GENSET MONITORING SYSTEM) - DEMO TA / SIDANG KONFIGURASI REST API
# ==============================================================================
# Host Mastify IoT Platform (Endpoint REST API)
MASTIFY_HOST=https://iot.mastify.com

# Device UUID target pada sistem Mastify
MASTIFY_DEVICE_ID=d89e2480-7389-11ef-9366-0775d79db145

# JWT Bearer Token otentikasi Mastify (Header: X-Authorization: Bearer <TOKEN>)
MASTIFY_JWT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_token_sidang_ta_gms

# Interval polling data telemetri berkala (dalam milidetik, rekomendasi: 2000 - 5000 ms)
POLLING_INTERVAL_MS=3000

# Mode Fallback Otomatis: jika koneksi internet/API gagal, otomatis alihkan ke backup lokal
AUTO_FALLBACK_OFFLINE=true
